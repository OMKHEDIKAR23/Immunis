# Nebius Token Factory

# Obtain your API key from the official Nebius console.

NEBIUS_API_KEY=

# OpenAI-compatible Token Factory endpoint

NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Set these after verifying available model IDs.

IMMUNIS_QUARANTINE_MODEL=
IMMUNIS_PLANNER_MODEL=

# Optional Tavily web search integration (added in a later phase)

TAVILY_API_KEY=

# Application configuration

IMMUNIS_ENV=development
IMMUNIS_LOG_LEVEL=INFO

# Safety limits

IMMUNIS_MAX_PLANNER_STEPS=6
IMMUNIS_MAX_INPUT_CHARS=20000
IMMUNIS_MAX_OUTPUT_TOKENS=1200
